---
import Base from "../layouts/Base.astro";
import { renderMarkdown, readDoc } from "../lib/standard.js";

// h1 уже нарисован страницей
const body = renderMarkdown(readDoc("ABOUT.md"), null, ["h1"]);
---

<Base
  title="Зачем нужен стандарт услуг фулфилмента"
  description="Какую задачу решает FSP: сравнение операторов без переписки и Excel. Что открытый стандарт даёт оператору фулфилмента, селлеру и площадке, с чего начать реализацию."
>
  <p class="crumbs"><a href="/">FSP</a> / Зачем нужен</p>
  <h1>Зачем нужен FSP</h1>

  <div class="prose" set:html={body} />
</Base>
